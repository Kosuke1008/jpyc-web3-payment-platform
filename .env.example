APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Blockchain selection is independent from APP_ENV. Phase 1 supports both
# profiles, but kaia-mainnet payment execution remains hard-disabled.
BLOCKCHAIN_NETWORK=kairos
BLOCKCHAIN_KAIROS_RPC_URL=https://public-en-kairos.node.kaia.io
BLOCKCHAIN_KAIA_MAINNET_RPC_URL=
BLOCKCHAIN_KAIA_MAINNET_SECONDARY_RPC_URL=
PAYMENTS_MAINNET_ENABLED=false
MAINNET_FEE_DELEGATION_ENABLED=false
MAINNET_BROADCAST_ENABLED=false
MAINNET_READINESS_MAX_BLOCK_LAG=10
PAYMENT_MAX_JPY=100000
PAYMENT_EXPIRATION_SECONDS=600

# Public LivT Wallet launch URL. Leave empty to keep the existing MetaMask-only UI.
LIVT_WALLET_URL=
LIVT_PAYMENT_TOKEN_EXPIRATION_MINUTES=30
# Legacy Sepolia compatibility values. Kaia profiles fix JPYC metadata in code.
WEB3_TOKEN_SYMBOL=JPYC
WEB3_TOKEN_DECIMALS=18
KAIA_FEE_DELEGATION_ENABLED=false
FEE_DELEGATION_MODE=self-hosted
# Kairos live review uses the private LivT sidecar on literal loopback only.
KAIA_FEE_DELEGATION_URL=http://127.0.0.1:19000
# Internal Laravel-to-sidecar bearer. The live runner generates it per run.
KAIA_FEE_DELEGATION_API_KEY=
KAIA_FEE_DELEGATION_MAX_GAS=150000
KAIA_FEE_DELEGATION_TIMEOUT_SECONDS=60
# Future managed mode uses the same backend-only URL/API key names with an
# approved HTTPS endpoint. Never expose the key through a VITE_* variable.
# Phase 7 controlled Kairos managed test gates. Keep disabled except for the
# one manually selected 1 JPYC Payment after readiness and dry-run pass.
KAIROS_MANAGED_LIVE_TEST_ENABLED=false
KAIROS_MANAGED_LIVE_TEST_PAYMENT_ID=
KAIROS_MANAGED_LIVE_TEST_MAX_JPYC=1

# Phase 8 self-hosted Mainnet pilot policy. Execution remains disabled; these
# limits only prepare the future fail-closed policy boundary.
SELF_HOSTED_MAINNET_FEE_PAYER_ENABLED=false
FEE_PAYER_KILL_SWITCH=true
SELF_HOSTED_MAINNET_MAX_PAYMENT_JPYC=1
SELF_HOSTED_MAINNET_MAX_GAS=150000
SELF_HOSTED_MAINNET_MAX_GAS_PRICE_WEI=750000000000
SELF_HOSTED_MAINNET_RATE_WINDOW_SECONDS=3600
SELF_HOSTED_MAINNET_MAX_ATTEMPTS_PER_USER=1
SELF_HOSTED_MAINNET_MAX_ATTEMPTS_PER_STORE=1
SELF_HOSTED_MAINNET_MAX_ATTEMPTS_PER_SENDER=1
SELF_HOSTED_MAINNET_MAX_ATTEMPTS_GLOBAL=1
SELF_HOSTED_MAINNET_DAILY_TRANSACTION_LIMIT=1
SELF_HOSTED_MAINNET_DAILY_KAIA_BUDGET=0.1
FEE_PAYER_MIN_RESERVE_KAIA=0.2
# Phase 10: exactly one approved Payment and a deliberately tiny balance cap.
# Keep both unset until the operator has approved the public Payment ID and
# calculated funding. Real values belong only in the staging secret/config store.
MAINNET_PILOT_PAYMENT_ID=
MAINNET_PILOT_MAX_FEE_PAYER_BALANCE_KAIA=
MAINNET_STAGING_ENVIRONMENT_ID=
MAINNET_STAGING_DATABASE_IDENTIFIER=
KAIROS_DATABASE_IDENTIFIER=
MAINNET_STAGING_CACHE_PREFIX=
KAIROS_CACHE_PREFIX=
MAINNET_STAGING_MERCHANT_ADDRESS=
KAIROS_MERCHANT_ADDRESS=
FEE_PAYER_KAIA_MAINNET_ADDRESS=
FEE_PAYER_KAIROS_ADDRESS=
MAINNET_STAGING_APPROVED_USER_IDS=
MAINNET_STAGING_APPROVED_SENDER_ADDRESSES=
MAINNET_STAGING_FEE_PAYER_HEALTH_URL=http://127.0.0.1:19000/health
MAINNET_STAGING_STAGE2_LEGACY_POLICY_RESOLVED=false
MAINNET_STAGING_ALLOW_CROSS_ENVIRONMENT_REUSE=false

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Blockchain selection is independent from APP_ENV. Phase 1 supports both
# profiles, but kaia-mainnet payment execution remains hard-disabled.
BLOCKCHAIN_NETWORK=kairos
BLOCKCHAIN_KAIROS_RPC_URL=https://public-en-kairos.node.kaia.io
BLOCKCHAIN_KAIA_MAINNET_RPC_URL=
BLOCKCHAIN_KAIA_MAINNET_SECONDARY_RPC_URL=
PAYMENTS_MAINNET_ENABLED=false
MAINNET_FEE_DELEGATION_ENABLED=false
MAINNET_BROADCAST_ENABLED=false
MAINNET_READINESS_MAX_BLOCK_LAG=10
PAYMENT_MAX_JPY=100000
PAYMENT_EXPIRATION_SECONDS=600

# Public LivT Wallet launch URL. Leave empty to keep the existing MetaMask-only UI.
LIVT_WALLET_URL=
LIVT_PAYMENT_TOKEN_EXPIRATION_MINUTES=30
# Legacy Sepolia compatibility values. Kaia profiles fix JPYC metadata in code.
WEB3_TOKEN_SYMBOL=JPYC
WEB3_TOKEN_DECIMALS=18
KAIA_FEE_DELEGATION_ENABLED=false
FEE_DELEGATION_MODE=self-hosted
# Kairos live review uses the private LivT sidecar on literal loopback only.
KAIA_FEE_DELEGATION_URL=http://127.0.0.1:19000
# Internal Laravel-to-sidecar bearer. The live runner generates it per run.
KAIA_FEE_DELEGATION_API_KEY=
KAIA_FEE_DELEGATION_MAX_GAS=150000
KAIA_FEE_DELEGATION_TIMEOUT_SECONDS=60
# Future managed mode uses the same backend-only URL/API key names with an
# approved HTTPS endpoint. Never expose the key through a VITE_* variable.
# Phase 7 controlled Kairos managed test gates. Keep disabled except for the
# one manually selected 1 JPYC Payment after readiness and dry-run pass.
KAIROS_MANAGED_LIVE_TEST_ENABLED=false
KAIROS_MANAGED_LIVE_TEST_PAYMENT_ID=
KAIROS_MANAGED_LIVE_TEST_MAX_JPYC=1
